{
	"name": "device-database-testing-astro",
	"type": "module",
	"version": "0.0.1",
	"packageManager": "pnpm@11.5.2",
	"engines": {
		"node": ">=24",
		"pnpm": ">=11"
	},
	"scripts": {
		"predev": "node ./scripts/sync-allowed-referrers.mjs",
		"dev": "astro dev",
		"prebuild": "node ./scripts/sync-allowed-referrers.mjs",
		"build": "astro build",
		"sync:allowed-referrers": "node ./scripts/sync-allowed-referrers.mjs",
		"preview": "astro preview",
		"astro": "astro",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "husky && if [ -d project.inlang ]; then pnpm run i18n:compile; fi",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide"
	},
	"lint-staged": {
		"*.{ts,mjs,astro}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{css,json,md}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@astrojs/netlify": "^7.0.13",
		"@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
		"astro": "^6.4.4",
		"lit": "^3.3.2",
		"lucide": "^1.17.0",
		"undici": "^8.10.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/node": "^10.1.4",
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@inlang/paraglide-js": "^2.23.0",
		"eslint": "^10.8.0",
		"eslint-plugin-astro": "^3.0.1",
		"eslint-plugin-lit": "^2.3.1",
		"eslint-plugin-unicorn": "^72.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.2.0",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vitest": "^3"
	}
}
