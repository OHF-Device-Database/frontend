---
import { getDimensions } from "../io/dimension";
import { m } from "../paraglide/messages.js";
import { localizeHref } from "../paraglide/runtime.js";
import { generic, render } from "../utilities/presentation";
import { PresentationRenderPresetRoleIcon } from "../utilities/presentation/preset";

// The search field is plain server-rendered HTML so it's visible immediately, without
// waiting for the island bundle. The <device-search> element enhances this markup in
// place (adds the suggestions dropdown / mobile fullscreen). Without JS, the form still
// works: it submits as a GET to /browse?q=…

interface Props {
	size?: "header" | "hero";
	placeholder?: string;
}

const { size = "header", placeholder = m.search_placeholder() } = Astro.props;
const iconSize = size === "hero" ? 22 : 18;

let dimensions;
try {
	const result = await getDimensions({}, AbortSignal.timeout(3_000));
	dimensions = result.dimensions;
} catch {
	dimensions = null;
}
---

<device-search
	size={size}
	placeholder={placeholder}
	dimensions={JSON.stringify(dimensions)}
>
	<div class={`searchbox searchbox-${size}`}>
		<form
			class="searchbox-input"
			role="search"
			action={localizeHref("/browse")}
			method="get"
		>
			<Fragment
				set:html={render(
					generic("search"),
					PresentationRenderPresetRoleIcon.withSize(iconSize),
				)}
			/>
			<input
				type="search"
				name="q"
				placeholder={placeholder}
				aria-label={m.search_devices_label()}
				aria-autocomplete="list"
				aria-expanded="false"
				autocomplete="off"
			/>
			<button type="button" class="searchbox-button-clear" hidden
				>{m.search_clear()}</button
			>
		</form>
	</div>
</device-search>
