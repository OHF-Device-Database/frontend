---
import { iconLogOut, iconShieldCheck } from "@openhomefoundation/icons";

import GitHubMark from "../assets/github-mark.svg";

import Message from "./Message.astro";
import Button from "./ui/Button.astro";
import Menu from "./ui/Menu.astro";
import MenuItem from "./ui/MenuItem.astro";
import Modal from "./ui/Modal.astro";

import logoMark from "../assets/logo-mark.svg?url";
import { AUTH_PROVIDERS } from "../io/auth/providers";
import { m } from "../paraglide/messages.js";
import { localizeHref } from "../paraglide/runtime.js";
import type { AuthProviderId } from "../io/auth/providers";

// TODO: point to /terms and /privacy once the legal copy is written
const termsLink = { href: localizeHref("/") };
const privacyLink = { href: localizeHref("/") };

const returnTo = Astro.url.pathname + Astro.url.search;

const marks: Record<AuthProviderId, typeof GitHubMark> = {
	github: GitHubMark,
};
---

<div class="account">
	<Button
		variant="primary"
		size="lg"
		shape="pill"
		class="account-trigger"
		data-modal-open="account-sign-in"
	>
		{m.nav_contribute()}
	</Button>

	<Modal
		id="account-sign-in"
		label={m.account_sign_in_title()}
		closeLabel={m.account_close()}
		class="account-modal"
	>
		<div class="account-sign-in">
			{/* fetched when the modal first opens, see the script below */}
			<img
				class="account-sign-in-mark"
				data-src={logoMark}
				alt=""
				width="49"
				height="53"
				decoding="async"
			/>
			<h2 class="account-sign-in-title">
				{m.account_sign_in_title()}
				<span>{m.account_sign_in_subtitle()}</span>
			</h2>
			<ul class="account-providers" aria-label={m.account_sign_in_providers()}>
				{
					AUTH_PROVIDERS.map((provider) => {
						const Mark = marks[provider.id];
						return (
							<li>
								<Button
									href={provider.signInHref(returnTo)}
									variant="tonal"
									size="lg"
									shape="pill"
									class="account-provider"
									data-provider-name={provider.name}
									data-astro-reload
									data-astro-prefetch="false"
								>
									<Mark width="16" height="16" aria-hidden="true" />
									<span data-label>{provider.name}</span>
								</Button>
							</li>
						);
					})
				}
			</ul>
			<p class="account-consent">
				<Message message={m.account_sign_in_consent}>
					<fragment slot="termsLink">
						{(children: unknown[]) => <a {...termsLink}>{children}</a>}
					</fragment>
					<fragment slot="privacyLink">
						{(children: unknown[]) => <a {...privacyLink}>{children}</a>}
					</fragment>
				</Message>
			</p>
		</div>
	</Modal>

	<Menu
		id="account-menu"
		label={m.account_title()}
		align="end"
		class="account-menu"
	>
		<button
			slot="trigger"
			type="button"
			class="account-avatar"
			popovertarget="account-menu"
			data-account-avatar
		>
			<img alt="" width="40" height="40" decoding="async" />
		</button>
		<p class="account-menu-login" data-account-login></p>
		<hr class="ui-menu-separator" />
		<MenuItem href={localizeHref("/account")} icon={iconShieldCheck}>
			{m.account_security()}
		</MenuItem>
		<MenuItem icon={iconLogOut} data-account-sign-out>
			<span data-label>{m.account_sign_out()}</span>
		</MenuItem>
		<p class="account-menu-error" role="alert" data-account-menu-error></p>
	</Menu>
</div>

<script>
	import { AUTH_PROVIDERS } from "../io/auth/providers";
	import { activeSession, AUTH_SESSIONS } from "../io/auth/providers.client";
	import { m } from "../paraglide/messages.js";
	import { markBusy } from "../utilities/busy";

	// the page may be cached for everyone, so the signed-in state is filled in here
	const sync = () => {
		const active = activeSession();
		document.documentElement.toggleAttribute(
			"data-github-session",
			active?.id === "github",
		);
		if (!active) {
			return;
		}

		const provider = AUTH_PROVIDERS.find(({ id }) => id === active.id);
		const avatar = document.querySelector("[data-account-avatar]");
		const image = avatar?.querySelector("img");
		const login = document.querySelector("[data-account-login]");
		if (!provider || !avatar || !image || !login) {
			return;
		}

		avatar.setAttribute(
			"aria-label",
			m.account_menu_label({ login: active.login }),
		);
		image.src = provider.avatarSrc(active.login, 40);
		login.textContent = m.account_menu_signed_in({ login: active.login });
	};

	const signOut = async (button: HTMLButtonElement) => {
		const active = activeSession();
		if (!active || button.getAttribute("aria-busy") === "true") {
			return;
		}

		// github has to revoke the token first, which can take a few seconds
		const restore = markBusy(button, m.account_signing_out());
		// cleared first, so a repeated failure is announced again
		const error = document.querySelector("[data-account-menu-error]");
		if (error) error.textContent = "";
		if (await active.session.signOut()) {
			window.location.reload();
			return;
		}

		restore();
		if (error) error.textContent = m.account_action_failed();
	};

	// the modal is on every page, the logo is only worth loading once it opens
	const loadMark = () => {
		const mark = document.querySelector<HTMLImageElement>(
			"#account-sign-in img[data-src]",
		);
		if (mark?.dataset["src"]) {
			mark.src = mark.dataset["src"];
			delete mark.dataset["src"];
		}
	};

	document.addEventListener("click", (event) => {
		if (!(event.target instanceof Element)) {
			return;
		}

		if (event.target.closest('[data-modal-open="account-sign-in"]')) {
			loadMark();
			return;
		}

		// the sign-in goes through our server and then the provider, which can
		// take a few seconds before the page changes
		const provider =
			event.target.closest<HTMLAnchorElement>(".account-provider");
		if (provider) {
			if (provider.getAttribute("aria-busy") === "true") {
				event.preventDefault();
				return;
			}
			// opens in a new tab or window, this page stays as it is
			if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
				return;
			}
			const restore = markBusy(
				provider,
				m.account_signing_in({
					provider: provider.dataset["providerName"] ?? "",
				}),
			);
			// coming back with the back button restores the page as it was left
			window.addEventListener(
				"pageshow",
				(shown) => {
					if (shown.persisted) restore();
				},
				{ once: true },
			);
			// a navigation that was stopped never leaves the page
			setTimeout(restore, 10_000);
			return;
		}

		const button = event.target.closest<HTMLButtonElement>(
			"[data-account-sign-out]",
		);
		if (button) {
			void signOut(button);
		}
	});

	document.addEventListener("astro:page-load", sync);
	for (const session of new Set(
		Object.values(AUTH_SESSIONS).map(({ event }) => event),
	)) {
		window.addEventListener(session, sync);
	}
</script>
