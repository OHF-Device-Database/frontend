---
import GitHubMark from "../assets/github-mark.svg";

import Message from "./Message.astro";

import { GITHUB_AUTHORIZE_PATH } from "../io/vendor/github/routes";
import { m } from "../paraglide/messages.js";
import { localizeHref } from "../paraglide/runtime.js";
import { generic, render } from "../utilities/presentation";
import { PresentationRenderPresetRoleIcon } from "../utilities/presentation/preset";

// TODO: point to /terms and /privacy once the legal copy is written
const termsLink = { href: localizeHref("/") };
const privacyLink = { href: localizeHref("/") };

const signInHref = `${GITHUB_AUTHORIZE_PATH}?${new URLSearchParams({
	"return-to": Astro.url.pathname + Astro.url.search,
})}`;
---

<div class="account">
	<button
		type="button"
		class="account-trigger"
		popovertarget="account-sign-in"
		aria-label={m.account_sign_in()}
	>
		<Fragment
			set:html={render(
				generic("logIn"),
				PresentationRenderPresetRoleIcon.withSize(18),
			)}
		/>
		<span class="account-trigger-label">{m.account_sign_in()}</span>
	</button>
	<div id="account-sign-in" class="account-popover" popover>
		<p class="account-popover-title">{m.account_sign_in_required()}</p>
		<p class="account-popover-consent">
			<Message message={m.account_sign_in_consent}>
				<fragment slot="termsLink">
					{(children: unknown[]) => <a {...termsLink}>{children}</a>}
				</fragment>
				<fragment slot="privacyLink">
					{(children: unknown[]) => <a {...privacyLink}>{children}</a>}
				</fragment>
			</Message>
		</p>
		<p class="account-popover-continue">{m.account_sign_in_continue_with()}</p>
		<a
			class="account-provider"
			href={signInHref}
			data-astro-reload
			data-astro-prefetch="false"
		>
			<GitHubMark width="18" height="18" class="icon" aria-hidden="true" />
			GitHub
		</a>
	</div>
	<a class="account-avatar" href={localizeHref("/account")} data-account-avatar>
		<img alt="" width="32" height="32" decoding="async" />
	</a>
</div>

<script>
	import {
		GITHUB_EVENT_SESSION,
		GitHubSession,
	} from "../io/vendor/github/session";
	import { m } from "../paraglide/messages.js";

	// the page may be cached for everyone, so the signed-in state is filled in here
	const sync = () => {
		const login = GitHubSession.login();
		document.documentElement.toggleAttribute(
			"data-github-session",
			typeof login !== "undefined",
		);

		const avatar = document.querySelector<HTMLAnchorElement>(
			"[data-account-avatar]",
		);
		const image = avatar?.querySelector("img");
		if (!avatar || !image || typeof login === "undefined") {
			return;
		}

		avatar.setAttribute("aria-label", m.account_menu_label({ login }));
		image.src = `https://avatars.githubusercontent.com/${encodeURIComponent(login)}?s=64`;
	};

	document.addEventListener("astro:page-load", sync);
	window.addEventListener(GITHUB_EVENT_SESSION, sync);
</script>
