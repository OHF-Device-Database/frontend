---
import { iconChevronDown } from "@openhomefoundation/icons";

import Message from "./Message.astro";
import Icon from "./ui/Icon.astro";

import { m } from "../paraglide/messages.js";
import { getLocale, localizeHref } from "../paraglide/runtime.js";
import {
	priceWatchCountries,
	priceWatcherDomain,
	priceWatchSuggestUrl,
} from "../utilities/price-watch";
import type { PriceWatchLink } from "../islands/price-watch-links";

interface Props {
	term: string;
}

const { term } = Astro.props;

const suggestLink = {
	href: priceWatchSuggestUrl,
	target: "_blank",
	rel: "noopener",
};

const countries = priceWatchCountries(getLocale());

// links are built here so the templates never ship to the client
const links: Record<string, PriceWatchLink[]> = Object.fromEntries(
	countries.map((country) => [
		country.code,
		country.watchers.map((watcher) => ({
			name: watcher.name,
			domain: priceWatcherDomain(watcher),
			href: watcher.template(term).href,
		})),
	]),
);

const flagUrls = import.meta.glob<string>("../assets/flags/*.svg", {
	eager: true,
	query: "?url&no-inline",
	import: "default",
});
const flags: Record<string, string> = Object.fromEntries(
	countries.flatMap((country) => {
		const url = flagUrls[`../assets/flags/${country.code}.svg`];
		return typeof url === "string" ? [[country.code, url]] : [];
	}),
);
---

<section class="article-section price-watch">
	<header class="price-watch-intro">
		<h2>{m.device_wtb_title()}</h2>
		<p>{m.device_wtb_lead()}</p>
	</header>

	<!-- Wraps select so the price-watch-links island can detect the selected country -->
	<price-watch-links
		links={JSON.stringify(links)}
		flags={JSON.stringify(flags)}
	>
		<div class="price-watch-country">
			<label class="price-watch-label" for="price-watch-country">
				{m.device_wtb_country()}
			</label>
			<div class="price-watch-select">
				<img class="price-watch-flag" alt="" width="24" height="24" hidden />
				<select id="price-watch-country">
					<option value="" disabled selected>{m.device_wtb_choose()}</option>
					{
						countries.map((country) => (
							<option value={country.code}>{country.name}</option>
						))
					}
				</select>
				<Icon icon={iconChevronDown} class="price-watch-chevron" />
			</div>
		</div>
	</price-watch-links>

	<div class="price-watch-notes">
		<p>{m.device_wtb_location()}</p>
		<p>
			<Message message={m.device_wtb_selection}>
				<fragment slot="link">
					{(children: unknown[]) => <a {...suggestLink}>{children}</a>}
				</fragment>
			</Message>
		</p>
		<p>
			<a href={`${localizeHref("/how-it-works")}#price-comparison-sites`}
				>{m.device_wtb_all_sites()}</a
			>
		</p>
	</div>
</section>
