---
import {
	iconArrowLeft,
	iconChevronDown,
	iconEqual,
	iconMonitor,
	iconMoon,
	iconSearch,
	iconSun,
	iconX,
} from "@openhomefoundation/icons";

import AccountMenu from "./AccountMenu.astro";
import LanguagePicker from "./LanguagePicker.astro";
import Message from "./Message.astro";
import SearchBox from "./SearchBox.astro";
import Button from "./ui/Button.astro";
import Icon from "./ui/Icon.astro";
import SegmentedControl from "./ui/SegmentedControl.astro";
import Sheet from "./ui/Sheet.astro";
import SheetNav from "./ui/SheetNav.astro";

import { m } from "../paraglide/messages.js";
import { localizeHref } from "../paraglide/runtime.js";
import {
	browseFiltersFromSearchParams,
	browseFiltersToHref,
	withCategoryToggled,
} from "../types/browse";
import { DeviceCategoryTopLevelId } from "../types/category";
import { LOGO_MARK_SVG } from "../utilities/logo";
import { device } from "../utilities/presentation";

interface Props {
	page: string;
	back?: string | undefined;
}

const { page } = Astro.props;
const showSearch = page !== "home";

const GITHUB_URL = "https://github.com/OHF-Device-Database";

const noFilters = browseFiltersFromSearchParams(new URLSearchParams());
const categories = DeviceCategoryTopLevelId.options
	.map((id) => ({
		label: device.category(id).label,
		href: localizeHref(browseFiltersToHref(withCategoryToggled(noFilters, id))),
	}))
	.toSorted((a, b) => a.label.localeCompare(b.label));

const pageLinks = [
	{ href: localizeHref("/"), label: m.nav_home() },
	{ href: localizeHref("/browse"), label: m.footer_browse() },
	{ href: localizeHref("/how-it-works"), label: m.footer_how_it_works() },
	{
		href: localizeHref("/editorial-stance"),
		label: m.footer_editorial_stance(),
	},
	{ href: localizeHref("/about"), label: m.footer_about() },
	{ href: localizeHref("/surveys"), label: m.surveys_title() },
].map((link) => ({ ...link, current: link.href === Astro.url.pathname }));

// on a phone the header has no Categories menu, so the list opens in the sheet
const links = [
	...pageLinks.slice(0, 2),
	{
		label: m.nav_categories(),
		class: "appnav-phone-only",
		attrs: { "data-appnav-view": "categories" },
	},
	...pageLinks.slice(2),
];
---

<header class="appnav" data-appnav>
	<div class="container appnav-inner">
		<div class="appnav-left">
			<a
				href={localizeHref("/")}
				class="brand"
				aria-label={m.nav_brand_home()}
				set:html={LOGO_MARK_SVG}
			/>
			<nav class="appnav-links" aria-label={m.nav_main_label()}>
				<a
					class="appnav-link"
					href={localizeHref("/browse")}
					aria-current={page === "browse" ? "page" : undefined}
				>
					{m.nav_explore()}
				</a>
				<div class="appnav-categories-anchor">
					<button
						type="button"
						class="appnav-link"
						popovertarget="appnav-categories"
					>
						{m.nav_categories()}
						<Icon icon={iconChevronDown} />
					</button>
					<div
						popover
						id="appnav-categories"
						class="appnav-categories"
						role="dialog"
						aria-label={m.nav_categories()}
					>
						<label class="appnav-categories-search">
							<Icon icon={iconSearch} size={20} />
							<input
								type="search"
								placeholder={m.search_placeholder()}
								aria-label={m.browse_modal_search_categories()}
								autocomplete="off"
								data-appnav-categories-filter
							/>
						</label>
						<hr />
						<ul class="appnav-categories-list">
							{
								categories.map((category) => (
									<li>
										<a href={category.href}>{category.label}</a>
									</li>
								))
							}
						</ul>
						<p class="appnav-categories-empty" hidden>
							{m.nav_categories_empty()}
						</p>
					</div>
				</div>
			</nav>
		</div>
		{
			showSearch ? (
				<SearchBox size="header" />
			) : (
				<div class="appnav-search-empty" />
			)
		}
		<div class="appnav-right">
			<AccountMenu />
			<Sheet id="appnav-menu" label={m.nav_menu()}>
				<button
					slot="trigger"
					type="button"
					class="ui-button appnav-menu-button"
					data-variant="tonal"
					data-size="lg"
					data-shape="pill"
					data-icon-only
					aria-label={m.nav_menu()}
					popovertarget="appnav-menu"
				>
					<Icon icon={iconEqual} class="appnav-menu-open" />
					<Icon icon={iconX} class="appnav-menu-close" />
				</button>
				<SheetNav label={m.nav_main_label()} links={links} />
				<hr class="ui-sheet-separator" />
				<div class="appnav-settings">
					<div data-theme-switch>
						<SegmentedControl
							name="appnav-theme"
							label={m.nav_theme_label()}
							shape="pill"
							value="auto"
							options={[
								{ value: "auto", label: m.nav_theme_auto(), icon: iconMonitor },
								{ value: "light", label: m.nav_theme_light(), icon: iconSun },
								{ value: "dark", label: m.nav_theme_dark(), icon: iconMoon },
							]}
						/>
					</div>
					<LanguagePicker id="appnav-language" />
				</div>
				<div class="appnav-menu-categories">
					<Button
						icon={iconArrowLeft}
						iconPlacement="only"
						label={m.nav_menu_back()}
						size="sm"
						shape="pill"
						data-appnav-view="main"
					/>
					<nav aria-label={m.nav_categories()}>
						{
							categories.map((category) => (
								<a href={category.href}>{category.label}</a>
							))
						}
					</nav>
				</div>
				<Fragment slot="footer">
					<Button
						size="xl"
						shape="pill"
						href={GITHUB_URL}
						target="_blank"
						rel="noopener noreferrer"
					>
						GitHub
					</Button>
					<p class="appnav-new-here">
						<Message message={m.nav_new_here}>
							<fragment slot="signInLink">
								{
									(children: unknown[]) => (
										<button type="button" popovertarget="account-sign-in">
											{children}
										</button>
									)
								}
							</fragment>
						</Message>
					</p>
				</Fragment>
			</Sheet>
		</div>
	</div>
</header>

<script>
	import "./theme-switch";

	// the menu shows its main view or the list of categories
	document.addEventListener("click", (event) => {
		const control =
			event.target instanceof Element
				? event.target.closest<HTMLElement>("[data-appnav-view]")
				: null;
		const menu = document.getElementById("appnav-menu");
		if (control === null || menu === null) {
			return;
		}

		if (control.dataset["appnavView"] === "categories") {
			menu.dataset["view"] = "categories";
		} else {
			delete menu.dataset["view"];
		}
	});

	// the Categories menu in the header narrows as you type
	document.addEventListener("input", (event) => {
		const input = event.target;
		if (
			!(input instanceof HTMLInputElement) ||
			!input.matches("[data-appnav-categories-filter]")
		) {
			return;
		}

		const panel = input.closest(".appnav-categories");
		const term = input.value.trim().toLocaleLowerCase();
		let shown = 0;
		for (const item of panel?.querySelectorAll("li") ?? []) {
			const match = (item.textContent ?? "").toLocaleLowerCase().includes(term);
			item.hidden = !match;
			shown += match ? 1 : 0;
		}

		const empty = panel?.querySelector<HTMLElement>(".appnav-categories-empty");
		if (empty) {
			empty.hidden = shown > 0;
		}
	});

	// each popover starts fresh: the full list, and the menu on its main view
	document.addEventListener(
		"toggle",
		(event) => {
			const popover = event.target;
			if (
				!(popover instanceof HTMLElement) ||
				!(event instanceof ToggleEvent) ||
				event.newState !== "open"
			) {
				return;
			}

			if (popover.id === "appnav-menu") {
				delete popover.dataset["view"];
			}

			if (popover.id === "appnav-categories") {
				const input = popover.querySelector<HTMLInputElement>(
					"[data-appnav-categories-filter]",
				);
				if (input) {
					input.value = "";
					input.dispatchEvent(new Event("input", { bubbles: true }));
					input.focus();
				}
			}
		},
		true,
	);
</script>
