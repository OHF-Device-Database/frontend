---
import LanguagePicker from "./LanguagePicker.astro";
import SearchBox from "./SearchBox.astro";

import { m } from "../paraglide/messages.js";
import { localizeHref } from "../paraglide/runtime.js";
import { LOGO_SVG } from "../utilities/logo";
import { generic, render } from "../utilities/presentation";
import { PresentationRenderPresetRoleIcon } from "../utilities/presentation/preset";

interface Props {
	page: string;
	back?: string | undefined;
}

const { page } = Astro.props;
const showSearch = page !== "home";
---

<div class="preview-banner">
	<div class="container preview-banner-inner">
		<p class="preview-banner-text">
			{m.nav_preview_banner_text()}
			<a
				href="https://github.com/OHF-Device-Database"
				target="_blank"
				rel="noopener noreferrer">{m.nav_preview_banner_learn_more()}</a
			>
		</p>
		<button
			type="button"
			class="preview-banner-close"
			aria-label={m.nav_preview_banner_dismiss()}
			data-preview-banner-close
		>
			<Fragment
				set:html={render(generic("x"), PresentationRenderPresetRoleIcon)}
			/>
		</button>
	</div>
</div>

<header class="appnav" data-appnav>
	<div class="container appnav-inner">
		<div class="appnav-left">
			<a
				href={localizeHref("/")}
				class="brand"
				aria-label={m.nav_brand_home()}
				set:html={LOGO_SVG}
			/>
		</div>
		{
			showSearch ? (
				<SearchBox size="header" />
			) : (
				<div class="appnav-search-empty" />
			)
		}
		<div class="appnav-right">
			<LanguagePicker />
			<a
				class="preview-badge"
				href="https://github.com/OHF-Device-Database"
				target="_blank"
				rel="noopener noreferrer"
			>
				<span>{m.nav_preview_badge()}</span>
			</a>
		</div>
	</div>
</header>

<script>
	const sync = () => {
		const nav = document.querySelector("[data-appnav]");
		if (nav) nav.classList.toggle("is-scrolled", window.scrollY > 0);
	};

	let bound = false;
	const bind = () => {
		if (bound) return;
		bound = true;
		sync();
		window.addEventListener("scroll", sync, { passive: true });
	};

	const bindBanner = () => {
		document
			.querySelector<HTMLButtonElement>("[data-preview-banner-close]")
			?.addEventListener("click", () => {
				(
					window as unknown as {
						DemoState?: { dismissPreviewBanner?: () => void };
					}
				).DemoState?.dismissPreviewBanner?.();
			});
	};

	document.addEventListener("astro:page-load", () => {
		bind();
		bindBanner();
	});
</script>
