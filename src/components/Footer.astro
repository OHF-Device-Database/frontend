---
import ohfLogoDark from "../assets/ohf-logo-dark.svg?raw";
import ohfLogoLight from "../assets/ohf-logo-light.svg?raw";

import { m } from "../paraglide/messages.js";
import { localizeHref } from "../paraglide/runtime.js";

interface Props {
	flush?: boolean;
}

const { flush = false } = Astro.props;

const ANALYTICS_BLOG_URL =
	"https://www.openhomefoundation.org/blog/making-our-web-analytics-open-source-with-plausible/";
const ANALYTICS_DASHBOARD_URL =
	"https://plausible.openhomefoundation.org/device-database-preview.openhomefoundation.org";

const ANALYTICS_TOKEN = "\u0000";
const DASHBOARD_TOKEN = "\u0001";

// One sentence with two links in it, so translators get a whole sentence rather
// than fragments they would have to keep in the right order. The links are
// substituted as tokens and split back out below, so each text part is rendered
// as text and no message file can inject markup.
const analyticsNoticeParts = m
	.footer_analytics({
		analyticsLink: ANALYTICS_TOKEN,
		dashboardLink: DASHBOARD_TOKEN,
	})
	// eslint-disable-next-line no-control-regex -- deliberate sentinels; control characters cannot occur in translated prose, so they are unambiguous delimiters
	.split(/([\u0000\u0001])/);
---

<footer class={"appfoot" + (flush ? " appfoot-flush" : "")}>
	<div class="container appfoot-row">
		<ul class="appfoot-links">
			<li><a href={localizeHref("/browse")}>{m.footer_browse()}</a></li>
			<li>
				<a href={localizeHref("/how-it-works")}>{m.footer_how_it_works()}</a>
			</li>
			<li>
				<a href={localizeHref("/editorial-stance")}>
					{m.footer_editorial_stance()}
				</a>
			</li>
			<li><a href={localizeHref("/about")}>{m.footer_about()}</a></li>
			<li><a href={localizeHref("/surveys")}>{m.surveys_title()}</a></li>
			<li>
				<a href="https://www.openhomefoundation.org/">{m.footer_ohf()}</a>
			</li>
		</ul>
		<span class="appfoot-legal-inline">
			<span class="appfoot-ohf-logo" aria-hidden="true">
				<span class="ohf-logo-light" set:html={ohfLogoLight} />
				<span class="ohf-logo-dark" set:html={ohfLogoDark} />
			</span>
			{m.footer_copyright({ year: "2026" })} · <a
				href={localizeHref("/imprint")}>{m.footer_imprint()}</a
			>
		</span>
	</div>
	<div class="container appfoot-analytics">
		<p>
			{
				analyticsNoticeParts.map((part) =>
					part === ANALYTICS_TOKEN ? (
						// set:text rather than a child expression: Prettier breaks a child
						// onto its own line and Astro emits that as a real space, which
						// would underline one space past the link text.
						<a
							href={ANALYTICS_BLOG_URL}
							rel="noopener"
							set:text={m.footer_analytics_link()}
						/>
					) : part === DASHBOARD_TOKEN ? (
						<a
							href={ANALYTICS_DASHBOARD_URL}
							rel="noopener"
							set:text={m.footer_analytics_dashboard()}
						/>
					) : (
						part
					),
				)
			}
		</p>
	</div>
</footer>
