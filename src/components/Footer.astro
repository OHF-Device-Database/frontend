---
import ohfLogoDark from "../assets/ohf-logo-dark.svg?raw";
import ohfLogoLight from "../assets/ohf-logo-light.svg?raw";

import Message from "./Message.astro";

import { m } from "../paraglide/messages.js";
import { localizeHref } from "../paraglide/runtime.js";

interface Props {
	flush?: boolean;
}

const { flush = false } = Astro.props;

const analyticsLink = {
	href: "https://www.openhomefoundation.org/blog/making-our-web-analytics-open-source-with-plausible/",
	rel: "noopener",
};
const dashboardLink = {
	href: "https://plausible.openhomefoundation.org/device-database-preview.openhomefoundation.org",
	rel: "noopener",
};
---

<footer class={"appfoot" + (flush ? " appfoot-flush" : "")}>
	<div class="container appfoot-row">
		<ul class="appfoot-links">
			<li>
				<a href={localizeHref("/how-it-works")}>{m.footer_how_it_works()}</a>
			</li>
			<li>
				<a href={localizeHref("/editorial-stance")}>
					{m.footer_editorial_stance()}
				</a>
			</li>
			<li><a href={localizeHref("/about")}>{m.footer_about()}</a></li>
			<li><a href={localizeHref("/surveys")}>{m.surveys_title()}</a></li>
		</ul>
		<span class="appfoot-legal-inline">
			<span class="appfoot-ohf-logo" aria-hidden="true">
				<span class="ohf-logo-light" set:html={ohfLogoLight} />
				<span class="ohf-logo-dark" set:html={ohfLogoDark} />
			</span>
			<span>
				<a
					href="https://www.openhomefoundation.org/"
					set:text={m.footer_copyright({ year: "2026" })}
				/> · <a href={localizeHref("/imprint")}>{m.footer_imprint()}</a>
			</span>
		</span>
	</div>
	<div class="container appfoot-analytics">
		<p>
			<Message message={m.footer_analytics}>
				<fragment slot="analyticsLink">
					{(children: unknown[]) => <a {...analyticsLink}>{children}</a>}
				</fragment>
				<fragment slot="dashboardLink">
					{(children: unknown[]) => <a {...dashboardLink}>{children}</a>}
				</fragment>
			</Message>
		</p>
	</div>
</footer>
