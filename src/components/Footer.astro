---
import { iconMonitor, iconMoon, iconSun } from "@openhomefoundation/icons";

import Flower from "../assets/footer-flower.svg";
import Vacuum from "../assets/footer-vacuum.svg";
import OhfBadge from "../assets/ohf-badge.svg";

import LanguagePicker from "./LanguagePicker.astro";
import SegmentedControl from "./ui/SegmentedControl.astro";

import { m } from "../paraglide/messages.js";
import { localizeHref } from "../paraglide/runtime.js";

const OHF_URL = "https://www.openhomefoundation.org/";

interface Props {
	/** a stair of colour bands from the page into the footer */
	steps?: boolean;
}

const { steps = false } = Astro.props;

// the top band is the closest to the page colour
const STEPS = [14, 29, 43, 57, 71, 86];
---

{
	steps && (
		<div class="appfoot-steps" aria-hidden="true">
			<div class="appfoot-steps-bands">
				{STEPS.map((percent) => (
					<i style={`--p:${percent}%`} />
				))}
			</div>
		</div>
	)
}

{/* dark in both themes, so everything inside takes the dark tokens */}
<footer class="appfoot" data-theme="dark">
	<Flower class="appfoot-flower" width="200" height="325" aria-hidden="true" />
	<div class="appfoot-inner">
		<a class="appfoot-ohf" href={OHF_URL}>
			<OhfBadge width="48" height="52" aria-hidden="true" />
			<span>{m.footer_ohf_initiative()}</span>
		</a>
		<div class="appfoot-bottom">
			<div class="appfoot-settings">
				<div data-theme-switch>
					<SegmentedControl
						name="appfoot-theme"
						label={m.nav_theme_label()}
						shape="pill"
						value="auto"
						options={[
							{ value: "auto", label: m.nav_theme_auto(), icon: iconMonitor },
							{ value: "light", label: m.nav_theme_light(), icon: iconSun },
							{ value: "dark", label: m.nav_theme_dark(), icon: iconMoon },
						]}
					/>
				</div>
				<LanguagePicker id="appfoot-language" />
			</div>
			<div class="appfoot-row">
				<p class="appfoot-legal">
					<a href={OHF_URL} set:text={m.footer_copyright({ year: "2026" })} /> ·
					<a href={localizeHref("/imprint")}>{m.footer_imprint()}</a>
				</p>
				<nav aria-label={m.footer_links_label()}>
					<ul class="appfoot-links">
						<li>
							<a href={localizeHref("/how-it-works")}>
								{m.footer_how_it_works()}
							</a>
						</li>
						<li>
							<a href={localizeHref("/editorial-stance")}>
								{m.footer_editorial_stance()}
							</a>
						</li>
						<li><a href={localizeHref("/about")}>{m.footer_about()}</a></li>
						<li><a href={localizeHref("/surveys")}>{m.surveys_title()}</a></li>
					</ul>
				</nav>
			</div>
		</div>
	</div>
	<Vacuum class="appfoot-vacuum" width="82" height="30" aria-hidden="true" />
</footer>

<script>
	import "./theme-switch";
</script>
