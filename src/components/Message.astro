---
import { renderMessage } from "../utilities/message";
import type {
	MarkupMessage,
	MessageInputs,
	MessageMarkup,
} from "../utilities/message";

// each markup tag renders through the slot of the same name, passed as a
// callback inside a lowercase fragment tag so Astro hands it the children
type Props<M extends MarkupMessage> = {
	message: M;
} & (undefined extends MessageInputs<M>
	? { inputs?: MessageInputs<M> }
	: { inputs: MessageInputs<M> });

const { message, inputs } = Astro.props;

const markup = Object.fromEntries(
	Object.keys(Astro.slots).map((name) => [
		name,
		(children: unknown[]) => Astro.slots.render(name, [children]),
	]),
) as MessageMarkup<typeof message>;

const rendered = renderMessage(
	message,
	inputs as MessageInputs<typeof message>,
	markup,
);
---

{rendered}
