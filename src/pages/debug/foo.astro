---
import Layout from "../../layouts/Layout.astro";

import { feature } from "../../utilities/feature";

export const prerender = false;

const enabled = feature("foo");
---

<Layout title="foo feature">
	<meta name="robots" content="noindex, nofollow" slot="head" />

	<div class="container-narrow content-page">
		<section class="content-section">
			<h2>ssr</h2>
			<strong>{enabled ? "enabled" : "disabled"}</strong>
		</section>

		<section class="content-section">
			<h2>css query</h2>
			<span class="foo-on">enabled</span><span class="foo-off">disabled</span>
		</section>

		<section class="content-section">
			<h2>csr</h2>
			<strong><foo-feature></foo-feature></strong>
		</section>
	</div>
</Layout>

<script>
	import { feature, FEATURE_EVENT } from "../../utilities/feature";
	import type { FeatureState } from "../../types/feature";

	class FooFeature extends HTMLElement {
		#onFeatures = (event: CustomEvent<FeatureState>): void => {
			this.#paint(event.detail.foo);
		};

		connectedCallback(): void {
			this.#paint(feature("foo"));
			window.addEventListener(FEATURE_EVENT, this.#onFeatures);
		}

		disconnectedCallback(): void {
			window.removeEventListener(FEATURE_EVENT, this.#onFeatures);
		}

		#paint(enabled: boolean): void {
			this.textContent = enabled ? "enabled" : "disabled";
		}
	}

	if (!customElements.get("foo-feature")) {
		customElements.define("foo-feature", FooFeature);
	}
</script>

<style is:global>
	.foo-on,
	.foo-off {
		display: none;
		font-weight: var(--fw-semibold);
	}
	html[data-feature-foo="on"] .foo-on,
	html[data-feature-foo="off"] .foo-off {
		display: inline;
	}
</style>
