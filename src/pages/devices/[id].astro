---
import haLogo from "../../assets/ha-logo.svg?raw";

import Layout from "../../layouts/Layout.astro";

import { getDevice, getDeviceCount } from "../../io/device";
import { getDimensions } from "../../io/dimension";
import { m } from "../../paraglide/messages.js";
import { getLocale, localizeHref } from "../../paraglide/runtime.js";
import { topLevelCategoryResolver } from "../../types/category";
import { deviceMonoMap, devicePolyMap } from "../../types/device";
import { Unknown } from "../../types/unknown";
import { cachePolicy } from "../../utilities/cache";
import * as presentation from "../../utilities/presentation";
import {
	PresentationRenderPresetRoleGlyph,
	PresentationRenderPresetRoleIcon,
} from "../../utilities/presentation/preset";
import type { IoDevicePoly } from "../../io/device";
import type { DeviceCategoryTopLevelId } from "../../types/category";

export const prerender = false;

const { id } = Astro.params;
const result = typeof id !== "undefined" ? await getDevice(id) : undefined;

if (typeof result !== "undefined") {
	Astro.cache.set({ ...cachePolicy(result.caching) });
} else {
	Astro.cache.set({ maxAge: 60 });
	Astro.response.status = 404;
}

const [{ total }, { dimensions }] = await Promise.all([
	getDeviceCount(),
	getDimensions(),
]);
const resolveCategory = topLevelCategoryResolver(dimensions.categories);

const listingRow = (item: IoDevicePoly) => {
	const listed = devicePolyMap(item);
	const firstRawCategoryId = listed.categories?.at(0);

	return {
		id: listed.id,
		name: presentation.device.name(listed),
		integration: listed.integration.name,
		count: listed.count,
		presented: presentation.device.category(
			typeof firstRawCategoryId !== "undefined"
				? resolveCategory(firstRawCategoryId)
				: Unknown,
		),
	};
};

const formatDate = (date: Date): string =>
	date.toLocaleDateString(getLocale(), {
		day: "numeric",
		month: "short",
		year: "numeric",
	});

const view =
	typeof result !== "undefined"
		? (() => {
				const device = deviceMonoMap(result.device);

				const firstRawCategoryId = device.categories?.at(0);

				const firstCategoryId: DeviceCategoryTopLevelId | Unknown | undefined =
					typeof firstRawCategoryId !== "undefined"
						? resolveCategory(firstRawCategoryId)
						: undefined;

				const name = presentation.device.name(device);

				return {
					device,
					derived: {
						name,
						categories: {
							first:
								typeof firstCategoryId !== "undefined"
									? ({
											id: firstCategoryId,
											presented: presentation.device.category(firstCategoryId),
										} as const)
									: undefined,
						},
						connectivity: {
							presented: presentation.device.connectivity(device.connectivity),
							explanation:
								device.connectivity === "online"
									? m.device_connectivity_online_explanation()
									: device.connectivity === "offline"
										? m.device_connectivity_offline_explanation()
										: m.device_connectivity_unknown_explanation(),
						},
						docsUrl: `https://www.home-assistant.io/integrations/${device.integration.domain}`,
						entityDomains: [
							...new Set(device.entities.map((entity) => entity.domain)),
						],
						firstEncountered: formatDate(device.firstEncountered),
						duplicates: (result.device.duplicates?.items ?? []).map(listingRow),
						canonical:
							typeof result.device.canonical !== "undefined"
								? listingRow(result.device.canonical)
								: undefined,
						versions: {
							software: device.versions.software.toSorted(
								(a, b) =>
									a.firstEncountered.getTime() - b.firstEncountered.getTime(),
							),
							hardware: device.versions.hardware,
						},
					},
				};
			})()
		: null;
---

{
	view ? (
		<Layout
			page="detail"
			back="/browse"
			title={`${view.device.manufacturer} ${view.derived.name}`}
		>
			<div class="container detail-wrap">
				<nav class="breadcrumb" aria-label={m.device_breadcrumb_label()}>
					<a href={localizeHref("/browse")}>{m.device_breadcrumb_devices()}</a>
					{typeof view.derived.categories.first?.id === "string" ? (
						<>
							<span class="sep">›</span>
							<a
								href={localizeHref(
									`/browse?category=${view.derived.categories.first.id}`,
								)}
							>
								{view.derived.categories.first.presented.label}
							</a>
						</>
					) : (
						<p />
					)}
				</nav>

				<header class="detail-head">
					<div
						class="detail-image"
						set:html={presentation.render(
							presentation.device.category(
								view.derived.categories.first?.id ?? Unknown,
							),
							PresentationRenderPresetRoleGlyph,
						)}
					/>
					<div class="detail-title">
						<h1>{view.derived.name}</h1>
						<div class="detail-manu">
							{m.device_by()}{" "}
							<a
								href={localizeHref(
									`/browse?manufacturer=${encodeURIComponent(view.device.manufacturer)}`,
								)}
							>
								{view.device.manufacturer}
							</a>
						</div>
						<div class="glance">
							<span class="glance-key">{m.device_connectivity()}</span>
							<span
								class={
									"local-indicator " + view.derived.connectivity.presented.cls
								}
							>
								<span class="dot" />
								{view.derived.connectivity.presented.label}
							</span>
							<span class="glance-key">{m.device_ha_integration()}</span>
							<span>{view.device.integration.name}</span>
						</div>
					</div>
				</header>

				<div class="detail-body">
					<section class="detail-connectivity">
						<figure class="detail-figure">
							<div class="detail-figure-frame">
								<div class="detail-connectivity connectivity-flush">
									<span
										class="detail-connectivity-dot"
										style={`background: ${view.derived.connectivity.presented.color}`}
									/>
									<span class="detail-connectivity-text">
										{view.derived.connectivity.presented.label}
									</span>
								</div>
								<p class="detail-connectivity-body">
									{view.derived.connectivity.explanation}
								</p>
							</div>
						</figure>
					</section>

					<main class="article">
						<section class="article-section ha-connect">
							<span
								class="ha-connect-logo"
								aria-hidden="true"
								set:html={haLogo}
							/>
							<h2>{m.device_ha_connect_title()}</h2>

							<p>{m.device_ha_connect_body()}</p>
							<dl class="ha-meta">
								<dt>{m.device_integration()}</dt>
								<dd>{view.device.integration.name}</dd>
								{view.derived.entityDomains.length > 0 && (
									<>
										<dt>{m.device_supported_entities()}</dt>
										<dd class="ha-entity-chips">
											{view.derived.entityDomains.map((domain) => (
												<span class="ha-entity-chip mono">{domain}</span>
											))}
										</dd>
									</>
								)}
							</dl>

							<p class="ha-docs-link">
								<a href={view.derived.docsUrl} target="_blank" rel="noopener">
									{m.device_read_docs()}{" "}
									<span
										set:html={presentation.render(
											presentation.generic("open"),
											PresentationRenderPresetRoleIcon,
										)}
									/>
								</a>
							</p>
						</section>

						<section class="article-section">
							<h2>{m.device_specifications()}</h2>
							<div class="spec-accordions">
								<details class="spec-acc" open>
									<summary class="spec-acc-summary">
										<span>{m.device_ecosystems()}</span>
										<span
											class="spec-acc-chevron"
											set:html={presentation.render(
												presentation.generic("chevronDown"),
												PresentationRenderPresetRoleIcon,
											)}
										/>
									</summary>
									<div class="spec-acc-body">
										<dl class="spec-dl">
											<div class="trait-row">
												<dt>{m.device_connects_with()}</dt>
												<dd>
													<span class="ha-chip">
														<span
															class="ha-chip-badge"
															aria-hidden="true"
															set:html={haLogo}
														/>
														{m.device_home_assistant()}
													</span>
												</dd>
											</div>
										</dl>
									</div>
								</details>

								{view.derived.versions.software.length > 0 && (
									<details class="spec-acc" open>
										<summary class="spec-acc-summary">
											<span>{m.device_software_version()}</span>
											<span
												class="spec-acc-chevron"
												set:html={presentation.render(
													presentation.generic("chevronDown"),
													PresentationRenderPresetRoleIcon,
												)}
											/>
										</summary>
										<div class="spec-acc-body">
											<dl class="spec-dl">
												<div class="trait-row">
													<dt>{m.device_current()}</dt>
													<dd class="spec-version-dd">
														<span class="mono">
															{view.derived.versions.software.at(0)?.version}
														</span>
														{view.derived.versions.software.length > 1 && (
															<version-history
																entries={JSON.stringify(
																	view.device.versions.software.map((v) => ({
																		version: v.version,
																		installs: v.active,
																		current:
																			v.version ===
																			view.derived.versions.software.at(0)
																				?.version,
																	})),
																)}
															/>
														)}
													</dd>
												</div>
											</dl>
										</div>
									</details>
								)}

								{view.derived.versions.hardware.length > 0 && (
									<details class="spec-acc" open>
										<summary class="spec-acc-summary">
											<span>{m.device_hardware_version()}</span>
											<span
												class="spec-acc-chevron"
												set:html={presentation.render(
													presentation.generic("chevronDown"),
													PresentationRenderPresetRoleIcon,
												)}
											/>
										</summary>
										<div class="spec-acc-body">
											<dl class="spec-dl">
												<div class="trait-row">
													{view.derived.versions.hardware.length > 1 && (
														<version-history
															entries={JSON.stringify(
																view.device.versions.hardware.map((v) => ({
																	version: v.version,
																	current: false,
																})),
															)}
														/>
													)}
												</div>
											</dl>
										</div>
									</details>
								)}

								<details class="spec-acc" open>
									<summary class="spec-acc-summary">
										<span>{m.device_product_identifiers()}</span>
										<span
											class="spec-acc-chevron"
											set:html={presentation.render(
												presentation.generic("chevronDown"),
												PresentationRenderPresetRoleIcon,
											)}
										/>
									</summary>
									{typeof view.device.modelId !== "undefined" && (
										<div class="spec-acc-body">
											<dl class="spec-dl">
												<div class="trait-row">
													<dt>{m.device_model_number()}</dt>
													<dd>
														<span class="spec-chip mono">
															{view.device.modelId}
														</span>
													</dd>
												</div>
											</dl>
										</div>
									)}
								</details>
							</div>
						</section>
					</main>

					<aside>
						<div class="aside-card aside-stats">
							<h4>{m.device_real_world_data()}</h4>
							<dl class="aside-stat-list">
								<div class="aside-stat">
									<dt>{m.device_reports()}</dt>
									<dd>{view.device.count.toLocaleString(getLocale())}</dd>
								</div>

								<div class="aside-stat">
									<dt>{m.device_first_seen()}</dt>
									<dd>{view.derived.firstEncountered}</dd>
								</div>
							</dl>
							<p class="aside-stats-note">{m.device_stats_note()}</p>
							<p class="aside-source-linkrow">
								<a href={localizeHref("/how-it-works")}>
									{m.device_methodology_link()}{" "}
									<span
										set:html={presentation.render(
											presentation.generic("open"),
											PresentationRenderPresetRoleIcon.withSize(12),
										)}
									/>
								</a>
							</p>
						</div>

						{typeof view.derived.canonical !== "undefined" && (
							<div class="aside-card aside-duplicates">
								<h4>{m.device_main_listing()}</h4>
								<ul class="aside-duplicate-list">
									<li>
										<a
											class="aside-duplicate-row"
											href={localizeHref(
												`/devices/${view.derived.canonical.id}`,
											)}
										>
											<span
												class="aside-duplicate-icon"
												set:html={presentation.render(
													view.derived.canonical.presented,
													PresentationRenderPresetRoleIcon.withSize(16),
												)}
											/>
											<span class="aside-duplicate-main">
												<span class="aside-duplicate-name">
													{view.derived.canonical.name}
												</span>
												<span class="aside-duplicate-integration">
													{view.derived.canonical.integration}
												</span>
											</span>
											<span class="aside-duplicate-count">
												{view.derived.canonical.count.toLocaleString(
													getLocale(),
												)}
											</span>
										</a>
									</li>
								</ul>
								<p class="aside-stats-note">{m.device_main_listing_note()}</p>
							</div>
						)}

						{view.derived.duplicates.length > 0 && (
							<div class="aside-card aside-duplicates">
								<h4>{m.device_also_listed_as()}</h4>
								<ul class="aside-duplicate-list">
									{view.derived.duplicates.map((duplicate) => (
										<li>
											<a
												class="aside-duplicate-row"
												href={localizeHref(`/devices/${duplicate.id}`)}
											>
												<span
													class="aside-duplicate-icon"
													set:html={presentation.render(
														duplicate.presented,
														PresentationRenderPresetRoleIcon.withSize(16),
													)}
												/>
												<span class="aside-duplicate-main">
													<span class="aside-duplicate-name">
														{duplicate.name}
													</span>
													<span class="aside-duplicate-integration">
														{duplicate.integration}
													</span>
												</span>
												<span class="aside-duplicate-count">
													{duplicate.count.toLocaleString(getLocale())}
												</span>
											</a>
										</li>
									))}
								</ul>
								<p class="aside-stats-note">{m.device_also_listed_note()}</p>
							</div>
						)}
					</aside>
				</div>
			</div>
		</Layout>
	) : (
		<Layout page="page" title={m.device_not_found_title()}>
			<div class="container" style="padding: 80px 0; text-align: center;">
				<div class="eyebrow" style="margin-bottom: 12px;">
					404
				</div>
				<h1 style="margin-bottom: 16px;">{m.device_not_found_heading()}</h1>
				<a class="btn btn-primary" href={localizeHref("/browse")}>
					{m.device_not_found_browse_all({
						count: total.toLocaleString(getLocale()),
					})}
				</a>
			</div>
		</Layout>
	)
}
