---
import byOhfDark from "../../assets/by-ohf-dark.svg";
import byOhfLight from "../../assets/by-ohf-light.svg";

import Layout from "../../layouts/Layout.astro";

import { m } from "../../paraglide/messages.js";
import { localizeHref } from "../../paraglide/runtime.js";
import { localeStaticPaths } from "../../utilities/locale";

export const getStaticPaths = localeStaticPaths;
---

<Layout page="page" title={m.about_title()}>
	<div class="container-narrow content-page">
		<section class="content-section content-intro">
			<h1>{m.about_heading()}</h1>
			<p class="content-lede">{m.about_lede()}</p>
			<p class="content-prose">{m.about_body()}</p>
			<p class="content-prose">
				{m.about_read_prefix()}
				<a href={localizeHref("/how-it-works")}>{m.about_read_link()}</a>
				{m.about_read_suffix()}
			</p>

			<a
				class="content-ohf"
				href="https://www.openhomefoundation.org/"
				target="_blank"
				rel="noopener"
			>
				<picture>
					<source srcset={byOhfDark.src} media="(prefers-color-scheme: dark)" />
					<img src={byOhfLight.src} alt={m.about_ohf_logo_alt()} />
				</picture>
			</a>
		</section>
	</div>
</Layout>
