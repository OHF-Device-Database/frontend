---
import Layout from "../../layouts/Layout.astro";

import { m } from "../../paraglide/messages.js";
import { localeStaticPaths } from "../../utilities/locale";

export const getStaticPaths = localeStaticPaths;
---

<Layout page="page" title={m.imprint_title()}>
	<div class="container-narrow content-page">
		<section class="content-section content-intro">
			<h1>{m.imprint_title()}</h1>
			<p class="content-lede">{m.imprint_lede()}</p>
		</section>

		<section class="content-section">
			<h2>{m.imprint_operator_title()}</h2>
			<p class="content-prose">
				Open Home Foundation<br />
				Grabenstrasse 25<br />
				6340 Baar<br />
				Switzerland<br />
				CHE-416.988.952
			</p>
		</section>

		<section class="content-section">
			<h2>{m.imprint_contact_title()}</h2>
			<p class="content-prose">
				<a href="mailto:hello@openhomefoundation.org"
					>hello@openhomefoundation.org</a
				>
			</p>
			<p class="content-prose">
				<a href="tel:+41412444123">+41 041 244 41 23</a>
			</p>
		</section>
	</div>
</Layout>
