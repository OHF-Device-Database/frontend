---
import DeviceCard from "../../components/DeviceCard.astro";
import Layout from "../../layouts/Layout.astro";

import { getDevices } from "../../io/device";
import { getDimensions } from "../../io/dimension";
import { m } from "../../paraglide/messages.js";
import { getLocale, localizeHref } from "../../paraglide/runtime.js";
import {
	browseFiltersCount,
	browseFiltersFromSearchParams,
	browseFiltersToHref,
	browseFiltersToQuery,
	cleared,
	withCategoryToggled,
	withLocalOnly,
	withManufacturerToggled,
	withoutCategory,
	withoutManufacturer,
	withoutTerm,
} from "../../types/browse";
import {
	DeviceCategoryTopLevelId,
	topLevelCategoryResolver,
} from "../../types/category";
import { devicePolyMap } from "../../types/device";
import { paginationItems } from "../../types/pagination";
import { cachePolicy } from "../../utilities/cache";
import * as presentation from "../../utilities/presentation";
import { PresentationRenderPresetRoleIcon } from "../../utilities/presentation/preset";

export const prerender = false;

const PAGE_SIZE = 24;
const SIDEBAR_LIMIT = 8;

const filters = browseFiltersFromSearchParams(Astro.url.searchParams);
const pageParam = Number(Astro.url.searchParams.get("page") ?? "0");
const page =
	Number.isInteger(pageParam) && pageParam > 0 ? Math.floor(pageParam) : 0;

// each facet is counted against every other active filter. selecting a
// category narrows the manufacturers, while the category list itself
// keeps showing the alternatives (and vice versa)
const categoryFacetFilters = withoutCategory(filters);
const manufacturerFacetFilters = withoutManufacturer(filters);
const categoryDimensionsRequest = getDimensions(
	browseFiltersToQuery(categoryFacetFilters),
);
// with at most one dimension selected both facets share the same query
const manufacturerDimensionsRequest =
	browseFiltersToHref(categoryFacetFilters) ===
	browseFiltersToHref(manufacturerFacetFilters)
		? categoryDimensionsRequest
		: getDimensions(browseFiltersToQuery(manufacturerFacetFilters));

const [
	result,
	{ dimensions: categoryDimensions },
	{ dimensions: manufacturerDimensions },
] = await Promise.all([
	getDevices({
		...browseFiltersToQuery(filters),
		...(page > 0 ? { page } : {}),
		size: PAGE_SIZE,
	}),
	categoryDimensionsRequest,
	manufacturerDimensionsRequest,
]);

Astro.cache.set({ ...cachePolicy(result.caching), tags: ["devices"] });

const devices = result.devices.map(devicePolyMap);
// the category facet ignores the category filter, so it covers every
// category a listed device can carry
const resolveCategory = topLevelCategoryResolver(categoryDimensions.categories);
const total = result.total;
const pageCount = result.pages;

const categoryFacets = Object.entries(categoryDimensions.categories)
	.flatMap(([id, node]) => {
		const parsed = DeviceCategoryTopLevelId.safeParse(id);

		return parsed.success
			? [{ id: parsed.data, label: node.name, count: node.count }]
			: [];
	})
	.toSorted((a, b) => b.count - a.count || a.label.localeCompare(b.label));

const categoryRows = [
	...categoryFacets,
	...[...filters.category]
		.filter((id) => !categoryFacets.some((facet) => facet.id === id))
		.map((id) => ({
			id,
			label: presentation.device.category(id).label,
			count: 0,
		})),
];
const categoryLabel = new Map(categoryRows.map((row) => [row.id, row.label]));

const categoryVisible = [
	...categoryRows.slice(0, SIDEBAR_LIMIT),
	...categoryRows
		.slice(SIDEBAR_LIMIT)
		.filter((row) => filters.category.has(row.id)),
];
const categoryOverflow = categoryRows.length - categoryVisible.length;

// a selected manufacturer may have no devices left under the other filters;
// keep it listed so it can still be deselected
const manufacturerRows = [
	...manufacturerDimensions.manufacturers,
	...[...filters.manufacturer]
		.filter(
			(name) =>
				!manufacturerDimensions.manufacturers.some(
					(manufacturer) => manufacturer.name === name,
				),
		)
		.toSorted()
		.map((name) => ({ name, count: 0 })),
];

const manufacturerVisible = [
	...manufacturerRows.slice(0, SIDEBAR_LIMIT),
	...manufacturerRows
		.slice(SIDEBAR_LIMIT)
		.filter((manufacturer) => filters.manufacturer.has(manufacturer.name)),
];
const manufacturerOverflow =
	manufacturerRows.length - manufacturerVisible.length;

const categoryOptions = JSON.stringify(
	categoryRows.map(({ id, label, count }) => ({ id, label, count })),
);
const manufacturerOptions = JSON.stringify(
	manufacturerRows.map(({ name, count }) => ({
		id: name,
		label: name,
		count,
	})),
);

const chips = [
	...(typeof filters.term !== "undefined"
		? [
				{
					label: `“${filters.term}”`,
					href: browseFiltersToHref(withoutTerm(filters)),
				},
			]
		: []),
	...[...filters.category].map((id) => {
		const label =
			categoryLabel.get(id) ?? presentation.device.category(id).label;

		return {
			label:
				filters.categoryMode === "exclude"
					? m.browse_chip_not({ label })
					: label,
			href: browseFiltersToHref(withCategoryToggled(filters, id)),
		};
	}),
	...[...filters.manufacturer].map((name) => ({
		label:
			filters.manufacturerMode === "exclude"
				? m.browse_chip_not({ label: name })
				: name,
		href: browseFiltersToHref(withManufacturerToggled(filters, name)),
	})),
	...(filters.localOnly
		? [
				{
					label: m.browse_local_only_label(),
					href: browseFiltersToHref(withLocalOnly(filters, false)),
				},
			]
		: []),
];
const activeCount = browseFiltersCount(filters);

const pageHref = (target: number): string => {
	const params = new URLSearchParams(Astro.url.searchParams);
	if (target <= 0) {
		params.delete("page");
	} else {
		params.set("page", String(target));
	}
	const qs = params.toString();

	return localizeHref(qs.length > 0 ? `/browse?${qs}` : "/browse");
};

const pages = pageCount > 1 ? paginationItems(page, pageCount) : [];
const hasPrevious = page > 0;
const hasNext = page < pageCount - 1;

const clearedHref = localizeHref(browseFiltersToHref(cleared(filters)));
---

<Layout page="browse" title={m.browse_title()}>
	<div class="browse">
		<div class="container browse-grid">
			<div class="browse-toolbar">
				<div class="browse-toolbar-filters">
					<h2 class="browse-toolbar-title">{m.browse_filters()}</h2>
					{
						activeCount > 0 && (
							<a class="browse-toolbar-clear" href={clearedHref}>
								{m.browse_clear_all()}
							</a>
						)
					}
				</div>
				<div class="browse-toolbar-main">
					{
						chips.length > 0 && (
							<span class="browse-toolbar-chips">
								{chips.map((chip) => (
									<span class="filter-chip">
										<span class="filter-chip-label">{chip.label}</span>
										<a
											class="filter-chip-remove"
											href={localizeHref(chip.href)}
											aria-label={m.browse_remove_filter({ label: chip.label })}
										>
											<Fragment
												set:html={presentation.render(
													presentation.generic("x"),
													PresentationRenderPresetRoleIcon.withSize(12),
												)}
											/>
										</a>
									</span>
								))}
							</span>
						)
					}
					<p
						class="browse-match-count"
						set:html={m.browse_match_count({
							count: `<b>${total.toLocaleString(getLocale())}</b>`,
						})}
					/>
				</div>
			</div>
			<details class="browse-filters" open>
				<summary class="browse-filters-summary">{m.browse_filters()}</summary>
				<form
					class="filters"
					method="get"
					action={localizeHref("/browse")}
					aria-label={m.browse_filters()}
					data-browse-filters
				>
					{
						typeof filters.term !== "undefined" && (
							<input type="hidden" name="q" value={filters.term} />
						)
					}
					<div class="local-only-toggle">
						<label class="local-only-toggle-row">
							<span class="local-only-toggle-text">
								<span class="local-only-toggle-label">
									{m.browse_local_only_label()}
								</span>
								<span class="local-only-toggle-hint">
									{m.browse_local_only_hint()}
								</span>
							</span>
							<span class={"switch" + (filters.localOnly ? " is-on" : "")}>
								<input
									type="checkbox"
									name="local"
									value="1"
									checked={filters.localOnly}
									aria-label={m.browse_local_only_label()}
								/>
								<span class="switch-track"></span>
								<span class="switch-thumb"></span>
							</span>
						</label>
					</div>
					<div class="filter-group">
						<div class="filter-group-head">
							<div class="filter-group-label">{m.browse_category_label()}</div>
							<div
								class="filter-mode"
								role="radiogroup"
								aria-label={m.browse_mode_label()}
							>
								<label
									class={"filter-mode-btn" +
										(filters.categoryMode === "include" ? " is-active" : "")}
								>
									<input
										type="radio"
										name="categoryMode"
										value="include"
										checked={filters.categoryMode === "include"}
									/>
									<span>{m.browse_mode_is()}</span>
								</label>
								<label
									class={"filter-mode-btn" +
										(filters.categoryMode === "exclude" ? " is-active" : "")}
								>
									<input
										type="radio"
										name="categoryMode"
										value="exclude"
										checked={filters.categoryMode === "exclude"}
									/>
									<span>{m.browse_mode_is_not()}</span>
								</label>
							</div>
						</div>
						<div class="filter-options">
							{
								categoryVisible.map((row) => (
									<label class="filter-row">
										<input
											type="checkbox"
											name="category"
											value={row.id}
											checked={filters.category.has(row.id)}
										/>
										<span class="filter-row-text">{row.label}</span>
										<span class="count">
											{row.count.toLocaleString(getLocale())}
										</span>
									</label>
								))
							}
							{
								categoryOverflow > 0 && (
									<button
										type="button"
										class="filter-more"
										data-filter-more="category"
									>
										<Fragment
											set:html={presentation.render(
												presentation.generic("search"),
												PresentationRenderPresetRoleIcon.withSize(16),
											)}
										/>
										<span>{m.browse_more()}</span>
									</button>
								)
							}
						</div>
					</div>
					<div class="filter-group">
						<div class="filter-group-head">
							<div class="filter-group-label">
								{m.browse_manufacturer_label()}
							</div>
							<div
								class="filter-mode"
								role="radiogroup"
								aria-label={m.browse_mode_label()}
							>
								<label
									class={"filter-mode-btn" +
										(filters.manufacturerMode === "include"
											? " is-active"
											: "")}
								>
									<input
										type="radio"
										name="manufacturerMode"
										value="include"
										checked={filters.manufacturerMode === "include"}
									/>
									<span>{m.browse_mode_is()}</span>
								</label>
								<label
									class={"filter-mode-btn" +
										(filters.manufacturerMode === "exclude"
											? " is-active"
											: "")}
								>
									<input
										type="radio"
										name="manufacturerMode"
										value="exclude"
										checked={filters.manufacturerMode === "exclude"}
									/>
									<span>{m.browse_mode_is_not()}</span>
								</label>
							</div>
						</div>
						<div class="filter-options">
							{
								manufacturerVisible.map((manufacturer) => (
									<label class="filter-row">
										<input
											type="checkbox"
											name="manufacturer"
											value={manufacturer.name}
											checked={filters.manufacturer.has(manufacturer.name)}
										/>
										<span class="filter-row-text">{manufacturer.name}</span>
										<span class="count">
											{manufacturer.count.toLocaleString(getLocale())}
										</span>
									</label>
								))
							}
							{
								manufacturerOverflow > 0 && (
									<button
										type="button"
										class="filter-more"
										data-filter-more="manufacturer"
									>
										<Fragment
											set:html={presentation.render(
												presentation.generic("search"),
												PresentationRenderPresetRoleIcon.withSize(16),
											)}
										/>
										<span>{m.browse_more()}</span>
									</button>
								)
							}
						</div>
					</div>
				</form>
			</details>

			<div class="browse-main">
				{
					devices.length === 0 ? (
						<div class="browse-empty">
							<h2>{m.browse_empty_title()}</h2>
							<p>{m.browse_empty_hint()}</p>
							<a class="btn btn-secondary" href={localizeHref("/browse")}>
								{m.browse_empty_clear()}
							</a>
						</div>
					) : (
						<>
							<div class="device-list">
								{devices.map((device) => (
									<DeviceCard
										device={device}
										resolveCategory={resolveCategory}
									/>
								))}
							</div>
							{pages.length > 0 && (
								<nav
									class="browse-pagination"
									aria-label={m.browse_pagination_label()}
								>
									{hasPrevious ? (
										<a
											class="browse-pagination-step"
											href={pageHref(page - 1)}
											rel="prev"
										>
											<span
												set:html={presentation.render(
													presentation.generic("chevronL"),
													PresentationRenderPresetRoleIcon.withSize(16),
												)}
											/>
											<span>{m.browse_previous()}</span>
										</a>
									) : (
										<span
											class="browse-pagination-step is-disabled"
											aria-disabled="true"
										>
											<span
												set:html={presentation.render(
													presentation.generic("chevronL"),
													PresentationRenderPresetRoleIcon.withSize(16),
												)}
											/>
											<span>{m.browse_previous()}</span>
										</span>
									)}
									<span class="browse-pagination-pages">
										{pages.map((item) =>
											item.gap ? (
												<span class="browse-pagination-gap" aria-hidden="true">
													…
												</span>
											) : item.page === page ? (
												<span
													class="browse-pagination-page is-current"
													aria-current="page"
												>
													{(item.page + 1).toLocaleString(getLocale())}
												</span>
											) : (
												<a
													class="browse-pagination-page"
													href={pageHref(item.page)}
													aria-label={m.browse_page_number({
														number: item.page + 1,
													})}
												>
													{(item.page + 1).toLocaleString(getLocale())}
												</a>
											),
										)}
									</span>
									{hasNext ? (
										<a
											class="browse-pagination-step"
											href={pageHref(page + 1)}
											rel="next"
										>
											<span>{m.browse_next()}</span>
											<span
												set:html={presentation.render(
													presentation.generic("chevronR"),
													PresentationRenderPresetRoleIcon.withSize(16),
												)}
											/>
										</a>
									) : (
										<span
											class="browse-pagination-step is-disabled"
											aria-disabled="true"
										>
											<span>{m.browse_next()}</span>
											<span
												set:html={presentation.render(
													presentation.generic("chevronR"),
													PresentationRenderPresetRoleIcon.withSize(16),
												)}
											/>
										</span>
									)}
								</nav>
							)}
						</>
					)
				}
			</div>
		</div>
		<filter-modal
			dim="category"
			label={m.browse_category_label()}
			searchplaceholder={m.browse_modal_search_categories()}
			emptylabel={m.browse_modal_empty_categories()}
			options={categoryOptions}
			selected={JSON.stringify([...filters.category].toSorted())}
			mode={filters.categoryMode}></filter-modal>
		<filter-modal
			dim="manufacturer"
			label={m.browse_manufacturer_label()}
			searchplaceholder={m.browse_modal_search_manufacturers()}
			emptylabel={m.browse_modal_empty_manufacturers()}
			options={manufacturerOptions}
			selected={JSON.stringify([...filters.manufacturer].toSorted())}
			mode={filters.manufacturerMode}
			lettergroups></filter-modal>
		<div class="filters-fab-wrap">
			<div class="container">
				<button
					type="button"
					class="filters-fab"
					aria-label={activeCount > 0
						? m.browse_fab_active({ count: activeCount })
						: m.browse_filters()}
					data-filter-sheet-open
				>
					<Fragment
						set:html={presentation.render(
							presentation.generic("filter"),
							PresentationRenderPresetRoleIcon.withSize(16),
						)}
					/>
					<span>
						{m.browse_filters()}{
							activeCount > 0 && (
								<span class="filters-fab-count"> · {activeCount}</span>
							)
						}
					</span>
				</button>
			</div>
		</div>
		<filter-sheet
			categoryoptions={categoryOptions}
			manufactureroptions={manufacturerOptions}></filter-sheet>
	</div>
</Layout>

<script>
	const bind = () => {
		const fab = document.querySelector<HTMLButtonElement>(
			"[data-filter-sheet-open]",
		);
		if (fab !== null && fab.dataset.bound !== "true") {
			fab.dataset.bound = "true";
			fab.addEventListener("click", () => {
				window.dispatchEvent(new CustomEvent("browse:open-sheet"));
			});
		}
		const form = document.querySelector<HTMLFormElement>(
			"[data-browse-filters]",
		);
		if (form === null || form.dataset.bound === "true") {
			return;
		}
		form.dataset.bound = "true";
		form.addEventListener("change", () => {
			form.requestSubmit();
		});
		form.addEventListener("submit", () => {
			const defaults = [
				...form.querySelectorAll<HTMLInputElement>(
					'input[type="radio"][value="include"]',
				),
			];
			for (const input of defaults) {
				input.disabled = true;
			}
			setTimeout(() => {
				for (const input of defaults) {
					input.disabled = false;
				}
			});
		});
		for (const button of form.querySelectorAll<HTMLButtonElement>(
			"[data-filter-more]",
		)) {
			button.addEventListener("click", () => {
				window.dispatchEvent(
					new CustomEvent("browse:open-filter", {
						detail: { dim: button.dataset.filterMore ?? "" },
					}),
				);
			});
		}
	};

	document.addEventListener("astro:page-load", bind);
	bind();
</script>
