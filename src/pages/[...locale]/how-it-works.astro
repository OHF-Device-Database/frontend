---
import Layout from "../../layouts/Layout.astro";

import { m } from "../../paraglide/messages.js";
import { localeStaticPaths } from "../../utilities/locale";
import { generic, render } from "../../utilities/presentation";
import { PresentationRenderPresetRoleIcon } from "../../utilities/presentation/preset";

export const getStaticPaths = localeStaticPaths;

const ext = render(
	generic("open"),
	PresentationRenderPresetRoleIcon.withSize(14),
);
---

<Layout page="page" title={m.hiw_title()}>
	<div class="content-page">
		<section class="content-section content-intro">
			<div class="container-narrow">
				<div class="content-eyebrow">{m.hiw_eyebrow()}</div>
				<h1>{m.hiw_title()}</h1>
				<p class="content-lede" set:html={m.hiw_lede()} />
			</div>
		</section>

		<section class="content-section">
			<div class="container-narrow">
				<div class="steps">
					<div class="step">
						<div class="step-num">1</div>
						<h3>{m.hiw_step_1_title()}</h3>
						<p>
							{m.hiw_step_1_body()}
							<a
								class="content-link"
								href="https://www.home-assistant.io/blog/2026/02/02/about-device-database/#now-its-over-to-you"
								target="_blank"
								rel="noopener">{m.hiw_step_1_link()}<span set:html={ext} /></a
							>
						</p>
					</div>
					<div class="step">
						<div class="step-num">2</div>
						<h3>{m.hiw_step_2_title()}</h3>
						<p>{m.hiw_step_2_body()}</p>
					</div>
					<div class="step">
						<div class="step-num">3</div>
						<h3>{m.hiw_step_3_title()}</h3>
						<p>{m.hiw_step_3_body()}</p>
					</div>
				</div>
			</div>
		</section>

		<section class="content-section">
			<div class="container-narrow">
				<h2>{m.hiw_entry_title()}</h2>
				<p class="content-prose">{m.hiw_entry_body_1()}</p>
				<p class="content-prose">{m.hiw_entry_body_2()}</p>
			</div>
		</section>

		<section class="content-section">
			<div class="container-narrow">
				<h2>{m.hiw_contribute_title()}</h2>
				<p class="content-prose">
					{m.hiw_contribute_prefix()}
					<a
						class="content-link"
						href="https://www.home-assistant.io/blog/2026/02/02/about-device-database/#now-its-over-to-you"
						target="_blank"
						rel="noopener">{m.hiw_contribute_link()}<span set:html={ext} /></a
					>{m.hiw_contribute_suffix()}
				</p>
				<p class="content-prose">
					{m.hiw_contribute_roadmap_prefix()}
					<a
						class="content-link"
						href="https://github.com/orgs/OpenHomeFoundation/projects/8/views/1"
						target="_blank"
						rel="noopener"
						>{m.hiw_contribute_roadmap_link()}<span set:html={ext} /></a
					>{m.hiw_contribute_roadmap_suffix()}
				</p>
				<p class="content-prose">
					<a
						class="content-link"
						href="https://github.com/orgs/OHF-Device-Database/discussions"
						target="_blank"
						rel="noopener"
						>{m.hiw_contribute_discussion_link()}<span set:html={ext} /></a
					>
					{m.hiw_contribute_discussion_suffix()}
				</p>
			</div>
		</section>
	</div>
</Layout>
