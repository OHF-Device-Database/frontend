---
import House from "../../assets/how-it-works-house.svg";

import Message from "../../components/Message.astro";
import Layout from "../../layouts/Layout.astro";

import { m } from "../../paraglide/messages.js";
import { getLocale } from "../../paraglide/runtime.js";
import { localeStaticPaths } from "../../utilities/locale";
import { generic, render } from "../../utilities/presentation";
import { PresentationRenderPresetRoleIcon } from "../../utilities/presentation/preset";
import {
	priceWatchCountries,
	priceWatcherDomain,
	priceWatchSuggestUrl,
} from "../../utilities/price-watch";

export const getStaticPaths = localeStaticPaths;

const ext = render(
	generic("open"),
	PresentationRenderPresetRoleIcon.withSize(14),
);

const countries = priceWatchCountries(getLocale());

const suggestLink = {
	class: "hiw-link",
	href: priceWatchSuggestUrl,
	target: "_blank",
	rel: "noopener",
};

const flags = import.meta.glob<string>("../../assets/flags/*.svg", {
	eager: true,
	query: "?url",
	import: "default",
});
---

<Layout page="page" title={m.hiw_title()}>
	<div class="hiw">
		<header class="hiw-intro hiw-measure">
			<House class="hiw-art" width="178" height="246" aria-hidden="true" />
			<p class="hiw-eyebrow">{m.hiw_title()}</p>
			<h1>{m.hiw_heading()}</h1>
			<p class="hiw-lede" set:html={m.hiw_lede()} />
		</header>

		<ol class="hiw-steps" role="list">
			<li class="hiw-step">
				<span class="hiw-step-num">1</span>
				<div>
					<h2>{m.hiw_step_1_title()}</h2>
					<p>
						{m.hiw_step_1_body()}
						<a
							class="hiw-link"
							href="https://www.home-assistant.io/blog/2026/02/02/about-device-database/#now-its-over-to-you"
							target="_blank"
							rel="noopener">{m.hiw_step_1_link()}<span set:html={ext} /></a
						>
					</p>
				</div>
			</li>
			<li class="hiw-step">
				<span class="hiw-step-num">2</span>
				<div>
					<h2>{m.hiw_step_2_title()}</h2>
					<p>{m.hiw_step_2_body()}</p>
				</div>
			</li>
			<li class="hiw-step">
				<span class="hiw-step-num">3</span>
				<div>
					<h2>{m.hiw_step_3_title()}</h2>
					<p>{m.hiw_step_3_body()}</p>
				</div>
			</li>
		</ol>

		<section class="hiw-section">
			<div class="hiw-measure">
				<h2>{m.hiw_entry_title()}</h2>
				<p>{m.hiw_entry_body_1()}</p>
				<p>{m.hiw_entry_body_2()}</p>
			</div>
		</section>

		<section class="hiw-section">
			<div class="hiw-measure">
				<h2>{m.hiw_contribute_title()}</h2>
				<p>
					{m.hiw_contribute_prefix()}
					<a
						class="hiw-link"
						href="https://www.home-assistant.io/blog/2026/02/02/about-device-database/#now-its-over-to-you"
						target="_blank"
						rel="noopener">{m.hiw_contribute_link()}<span set:html={ext} /></a
					>{m.hiw_contribute_suffix()}
				</p>
				<p>
					{m.hiw_contribute_roadmap_prefix()}
					<a
						class="hiw-link"
						href="https://github.com/orgs/OpenHomeFoundation/projects/8/views/1"
						target="_blank"
						rel="noopener"
						>{m.hiw_contribute_roadmap_link()}<span set:html={ext} /></a
					>{m.hiw_contribute_roadmap_suffix()}
				</p>
				<p>
					<a
						class="hiw-link"
						href="https://github.com/orgs/OHF-Device-Database/discussions"
						target="_blank"
						rel="noopener"
						>{m.hiw_contribute_discussion_link()}<span set:html={ext} /></a
					>
					{m.hiw_contribute_discussion_suffix()}
				</p>
			</div>
		</section>

		<section class="hiw-section" id="price-comparison-sites">
			<div class="hiw-measure">
				<h2>{m.hiw_wtb_title()}</h2>
				<p>{m.hiw_wtb_body()}</p>
				<p>
					<Message message={m.hiw_wtb_suggest}>
						<fragment slot="link">
							{(children: unknown[]) => <a {...suggestLink}>{children}</a>}
						</fragment>
					</Message>
				</p>
				<dl class="price-sites">
					{
						countries.map((country) => (
							<div class="price-sites-row">
								<dt>
									<img
										class="price-sites-flag"
										src={flags[`../../assets/flags/${country.code}.svg`]}
										alt=""
										width="20"
										height="15"
									/>
									{country.name}
								</dt>
								<dd>
									{country.watchers.map((watcher) => (
										<a
											href={watcher.url.href}
											target="_blank"
											rel="noopener noreferrer nofollow"
										>
											{watcher.name}
											<span class="price-sites-domain">
												{priceWatcherDomain(watcher)}
											</span>
										</a>
									))}
								</dd>
							</div>
						))
					}
				</dl>
			</div>
		</section>
	</div>
</Layout>
