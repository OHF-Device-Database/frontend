---
import Layout from "../../layouts/Layout.astro";

import { m } from "../../paraglide/messages.js";
import { localeStaticPaths } from "../../utilities/locale";

export const getStaticPaths = localeStaticPaths;
---

<Layout page="page" title={m.editorial_title()}>
	<div class="container-narrow content-page">
		<section class="content-section content-intro">
			<h1>{m.editorial_title()}</h1>
			<p class="content-lede">{m.editorial_lede()}</p>
			<p class="content-prose">{m.editorial_intro()}</p>
		</section>

		<section class="content-section">
			<p class="content-prose" set:html={m.editorial_body_1()} />
			<p class="content-prose">{m.editorial_body_2()}</p>
			<p class="content-prose">{m.editorial_body_3()}</p>
		</section>

		<section class="content-section">
			<h2>{m.editorial_voice_title()}</h2>
			<p class="content-prose" set:html={m.editorial_voice_body_1()} />
			<p class="content-prose">{m.editorial_voice_body_2()}</p>
			<p class="content-prose">{m.editorial_voice_body_3()}</p>
		</section>
	</div>
</Layout>
