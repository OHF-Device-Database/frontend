---
import Layout from "../../layouts/Layout.astro";

import { m } from "../../paraglide/messages.js";
import { localeStaticPaths } from "../../utilities/locale";

export const getStaticPaths = localeStaticPaths;
---

<Layout page="page" title={m.editorial_title()}>
	<div class="stance">
		<header class="stance-intro">
			<p class="stance-eyebrow">{m.editorial_title()}</p>
			<h1>{m.editorial_lede()}</h1>
			<p class="stance-lede">{m.editorial_intro()}</p>
		</header>

		<div class="stance-body">
			<section class="stance-section">
				<p set:html={m.editorial_body_1()} />
				<p>{m.editorial_body_2()}</p>
				<p>{m.editorial_body_3()}</p>
			</section>

			<section class="stance-section">
				<h2>{m.editorial_voice_title()}</h2>
				<p set:html={m.editorial_voice_body_1()} />
				<p>{m.editorial_voice_body_2()}</p>
				<p>{m.editorial_voice_body_3()}</p>
			</section>
		</div>
	</div>
</Layout>
