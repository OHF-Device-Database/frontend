---
import SearchBox from "../../components/SearchBox.astro";
import Layout from "../../layouts/Layout.astro";

import { getDeviceCount } from "../../io/device";
import { m } from "../../paraglide/messages.js";
import { getLocale, localizeHref } from "../../paraglide/runtime.js";
import { cachePolicy } from "../../utilities/cache";

export const prerender = false;

const { total, caching } = await getDeviceCount();

Astro.cache.set({
	...cachePolicy(caching),
	tags: ["device-count"],
});
---

<Layout page="home">
	<div class="home-screen">
		<section class="hero">
			<div class="container hero-center">
				<h1>{m.home_title()}</h1>
				<p class="hero-lede">{m.home_lede()}</p>
				<div class="hero-search-wrap">
					<SearchBox size="hero" placeholder={m.home_search_placeholder()} />
				</div>
				<div class="hero-actions">
					<a href={localizeHref("/browse")}>
						{m.home_browse_all({ count: total.toLocaleString(getLocale()) })}
					</a>
				</div>
			</div>
		</section>
	</div>
</Layout>
